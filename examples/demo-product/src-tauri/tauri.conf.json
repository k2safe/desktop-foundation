{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Product Demo",
  "version": "0.1.0",
  "identifier": "com.desktopfoundation.demo-product",
  "build": {
    "beforeDevCommand": "pnpm dev --port 3000",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Product Demo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "backgroundColor": "#050314"
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
