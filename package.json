{
  "name": "desktop-foundation",
  "version": "0.1.37",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r build && pnpm -r type-check",
    "lint": "pnpm -r lint",
    "visual:regression": "node scripts/visual-regression.mjs",
    "visual:regression:update": "node scripts/visual-regression.mjs --update",
    "visual:regression:expanded": "node scripts/visual-regression.mjs --expanded",
    "visual:regression:expanded:update": "node scripts/visual-regression.mjs --expanded --update",
    "smoke:capabilities": "pnpm --filter @desktop-foundation/bridge build && node packages/create-desktop-app/bin/desktop-foundation.mjs smoke --report artifacts/foundation-smoke.json",
    "smoke:multipart": "pnpm --filter @desktop-foundation/bridge build && node scripts/smoke-multipart-upload.mjs",
    "smoke:external-ai-demo": "node scripts/smoke-external-ai-demo.mjs",
    "smoke:external-release": "node scripts/smoke-external-ai-demo.mjs",
    "pack:packages": "node scripts/pack-foundation-packages.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check-package-drift": "node scripts/check-package-manifest-drift.mjs",
    "release:local-check": "node scripts/release-local-check.mjs",
    "release:package-manifest": "node scripts/write-release-package-manifest.mjs",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "~5.8.2"
  }
}
