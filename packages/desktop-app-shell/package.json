{
  "name": "@desktop-foundation/app-shell",
  "version": "0.1.25",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs dist && tsc -p tsconfig.json && node ../../scripts/patch-dist-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@desktop-foundation/bridge": "workspace:*",
    "@desktop-foundation/ui-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
