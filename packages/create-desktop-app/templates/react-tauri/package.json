{
  "name": "{{PACKAGE_NAME}}",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host=127.0.0.1",
    "build": "pnpm type-check && pnpm build:web",
    "build:web": "vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview --host=127.0.0.1",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "doctor": "desktop-foundation doctor --report artifacts/foundation-doctor.json",
    "ci": "desktop-foundation-ci --type-check --build --strict",
    "package:desktop": "pnpm build:desktop && desktop-foundation-ci --no-type-check --no-build --package-desktop --manifest --release-plan",
    "release:manifest": "desktop-foundation-ci --no-type-check --no-build --manifest --release-plan",
    "visual:regression": "node scripts/visual-regression.mjs",
    "visual:regression:update": "node scripts/visual-regression.mjs --update"
  },
  "dependencies": {
    "@desktop-foundation/app-shell": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-app-shell-0.1.13.tgz",
    "@desktop-foundation/bridge": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-bridge-0.1.13.tgz",
    "@desktop-foundation/theme-presets": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-theme-presets-0.1.13.tgz",
    "@desktop-foundation/ui-react": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-ui-react-0.1.13.tgz",
    "@tauri-apps/api": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.8.2",
    "@desktop-foundation/create-desktop-app": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-create-desktop-app-0.1.13.tgz"
  },
  "pnpm": {
    "overrides": {
      "@desktop-foundation/app-shell": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-app-shell-0.1.13.tgz",
      "@desktop-foundation/bridge": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-bridge-0.1.13.tgz",
      "@desktop-foundation/theme-presets": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-theme-presets-0.1.13.tgz",
      "@desktop-foundation/ui-react": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-ui-react-0.1.13.tgz",
      "@desktop-foundation/create-desktop-app": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-create-desktop-app-0.1.13.tgz"
    }
  }
}
